# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommercedb?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
REFRESH_SECRET="change-me-to-a-long-refresh-secret-string"
ADMIN_SIGNUP_CODE="change-me-to-a-secret-business-code"

# Razorpay (test mode keys from https://dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# Redis Caching (optional)
REDIS_URL="redis://localhost:6379"

# Resend Email Notifications (optional)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="orders@yourstore.com"

# Cloudinary Image Upload (optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Client
CLIENT_URL="http://localhost:5173"
PORT=4000
